# ─── PaChat realtime gateway ──────────────────────────────────────────────────
# Copy to `.env` (or run `npm run setup` from the repo root, which generates
# this file with fresh secrets for you).

# HTTP / WebSocket listener
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated origins allowed to call the REST API and open sockets.
# The packaged desktop client sends no Origin header, so it is always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token signing. MUST be replaced with long random values before deploying.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret

# Where the embedded SQLite database and uploaded files live, relative to
# apps/server. Both directories are created on boot if missing.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Allow self-service account creation via POST /api/auth/register.
ALLOW_REGISTRATION=true

# Requests per minute per IP against the auth endpoints.
AUTH_RATE_LIMIT=20
